<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The launcher label for the HyperOS 4 fork, so it can be told apart
         from the original when both are installed. -->
    <application
        android:label="BitChord HOS4"
        tools:replace="android:label">

        <!-- Lets Lyricon list BitChord as a lyrics provider. -->
        <meta-data
            android:name="lyricon_module"
            android:value="true" />
        <meta-data
            android:name="lyricon_module_author"
            android:value="BitChord HOS4" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="Sends BitChord's synced lyrics to Lyricon" />
        <meta-data
            android:name="lyricon_module_tags"
            android:resource="@array/lyricon_module_tags" />
    </application>
</manifest>
